# 이 파일은 실제 값 없이 "어떤 환경변수가 필요한지"만 보여주는 템플릿입니다.
# 복사해서 .env로 저장한 뒤 실제 값을 채워 쓰세요: cp .env.example .env
# .env 자체는 .gitignore에 의해 GitHub에 올라가지 않습니다.

# --- Database (Postgres - Vercel의 Storage 탭에서 Postgres 연동을 추가하면 자동으로 채워집니다) ---
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# --- 영수증 사진 저장 (Vercel Blob - Storage 탭의 Blob 저장소 ".env.local" 탭에서 확인) ---
BLOB_READ_WRITE_TOKEN=""

# --- LLM (영수증 OCR / 규정 검토) ---
# OpenRouter의 무료 멀티모달 모델에 영수증 이미지를 보내 텍스트와 금액/상호/일시를 추출합니다.
LLM_MODEL="google/gemma-4-31b-it:free"

# OpenRouter 키: https://openrouter.ai 에서 발급받은 값 (sk-or-v1-... 형식)를 넣어주세요.
OPENROUTER_API_KEY=""

# --- 이메일 발송 (선택 기능) ---
# 아래 값이 비어있으면 이메일 발송 기능은 자동으로 비활성화되고, PDF 다운로드만 가능합니다.
# 회사(KIOST) SMTP 중계를 받으면 그 정보로 채우는 것을 권장합니다 - 개인 Gmail로 채우면
# 발송 메일이 전부 "그 개인 이메일에서 온 것"으로 여러 직원에게 노출되니 임시 테스트 용도로만 쓰세요.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="정총무"
SMTP_FROM_EMAIL=""
