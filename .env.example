# 이 파일은 실제 값 없이 "어떤 환경변수가 필요한지"만 보여주는 템플릿입니다.
# 복사해서 .env로 저장한 뒤 실제 값을 채워 쓰세요: cp .env.example .env
# .env 자체는 .gitignore에 의해 GitHub에 올라가지 않습니다.

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Google Vision API (OCR) ---
# Google Cloud Console에서 "Cloud Vision API"가 활성화되어 있어야 합니다.
GOOGLE_VISION_API_KEY=""

# --- LLM (규정 검토 에이전트) ---
# provider: "openrouter" 또는 "google" 중 선택
LLM_PROVIDER="openrouter"
LLM_MODEL="google/gemma-4-31b-it:free"

# OpenRouter를 쓸 경우: https://openrouter.ai 에서 발급받은 키 (sk-or-v1-... 형식)를 넣어주세요.
OPENROUTER_API_KEY=""

# Google Generative Language API(Gemini/Gemma)를 직접 쓸 경우, 아래 값을 사용합니다.
# 위 GOOGLE_VISION_API_KEY와 동일한 키를 재사용할 수 있습니다(같은 GCP 프로젝트에서
# "Generative Language API"도 활성화되어 있어야 함).
GOOGLE_GENAI_API_KEY=""

# --- 규정 문서 ---
REGULATIONS_DIR="./r1"

# --- 이메일 발송 (선택 기능) ---
# 아래 값이 비어있으면 이메일 발송 기능은 자동으로 비활성화되고, PDF 다운로드만 가능합니다.
# 회사(KIOST) SMTP 중계를 받으면 그 정보로 채우는 것을 권장합니다 - 개인 Gmail로 채우면
# 발송 메일이 전부 "그 개인 이메일에서 온 것"으로 여러 직원에게 노출되니 임시 테스트 용도로만 쓰세요.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="정총무"
SMTP_FROM_EMAIL=""
